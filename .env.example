# Generation and the frozen two-model jury (Chapter 8). Required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Independent judge audit (Section 8.4 addendum). Optional. -----------------
# Used ONLY by audit_sample.py and by evaluate.py runs that carry --suffix. These
# never touch the reported jury scores in evaluation.json or index.csv.

# Google, for the third rater. The client uses Google's OpenAI-compatible endpoint,
# so no extra SDK is required.
GOOGLE_API_KEY=

# Any open-weight host exposing an OpenAI-compatible chat-completions API
# (OpenRouter, Together, Fireworks, DeepInfra, ...). Set BOTH the key and the base
# URL of whichever host you use. For OpenRouter:
#   OPENWEIGHT_BASE_URL=https://openrouter.ai/api/v1
OPENWEIGHT_API_KEY=
OPENWEIGHT_BASE_URL=
